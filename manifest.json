{
  "manifest_version": 3,
  "name": "KIZAR Stream",
  "version": "1.2.0",
  "description": "Stream Netflix & Prime Video using cookies served live from the developer's GitHub repo. Shows live session counts. No developer mode.",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "https://ios.prod.ftl.netflix.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://api.ipify.org/*",
    "https://icanhazip.com/*",
    "https://kizar-control-room.vercel.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}